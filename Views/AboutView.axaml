<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CheckDuplicate.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="CheckDuplicate.Views.AboutView"
             x:DataType="vm:AboutViewModel"
             Background="{DynamicResource AppBackgroundBrush}">
    
    <Grid RowDefinitions="Auto,*" Margin="40">
        <!-- Main Content Centered -->
        <StackPanel Grid.Row="1" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <!-- Logo Area -->
            <Image Source="/Assets/Logo.ico" Width="100" Height="100" HorizontalAlignment="Center"/>
            
            <!-- App Name & Version -->
            <StackPanel HorizontalAlignment="Center" Spacing="5">
                <TextBlock Text="{Binding AppName}" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
            
            <!-- Description -->
            <TextBlock Text="{Binding Description}" 
                       Foreground="{DynamicResource TextSecondaryBrush}" 
                       FontSize="16" 
                       TextAlignment="Center" 
                       TextWrapping="Wrap"
                       MaxWidth="500"/>
            
            <Separator Margin="0,20" Background="#2A2A3C" Height="2"/>
            
            <!-- Company Info -->
            <StackPanel Spacing="10" HorizontalAlignment="Center">
                <TextBlock Text="{Binding CompanyName}" FontWeight="SemiBold" FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
                
                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                    <TextBlock Text="🌐" Foreground="{DynamicResource PrimaryBlueBrush}"/>
                    <TextBlock Text="{Binding Website}" Foreground="{DynamicResource PrimaryBlueBrush}"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                    <TextBlock Text="📧" Foreground="{DynamicResource PrimaryBlueBrush}"/>
                    <TextBlock Text="{Binding Email}" Foreground="{DynamicResource PrimaryBlueBrush}"/>
                </StackPanel>
            </StackPanel>
            
            <TextBlock Text="{Binding Copyright}" 
                       Margin="0,30,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" 
                       FontSize="12" 
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
